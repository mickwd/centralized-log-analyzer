# Copiar a .env y completar. Nunca commitear .env

# Base de datos (SQLite por defecto; PostgreSQL en producción)
LOGAN_DATABASE_URL=sqlite:///data/loganalyzer.db
# LOGAN_DATABASE_URL=postgresql+psycopg://loganalyzer:cambiar@localhost:5432/loganalyzer

LOGAN_INVENTORY_PATH=config/hosts.yaml
LOGAN_RULES_PATH=config/rules.yaml
LOGAN_SCHEDULE_MINUTES=5
LOGAN_DETECTION_LOOKBACK_MINUTES=60

# Notificaciones (opcionales)
LOGAN_WEBHOOK_URL=
LOGAN_SMTP_HOST=
LOGAN_SMTP_PORT=587
LOGAN_SMTP_USER=
LOGAN_SMTP_PASSWORD=
LOGAN_SMTP_FROM=loganalyzer@example.com
LOGAN_SMTP_TO=soporte@example.com

# Credenciales referenciadas desde config/hosts.yaml
WEB01_SSH_USER=collector
WEB01_SSH_KEY=/home/collector/.ssh/id_ed25519
DB01_SSH_USER=collector
DB01_SSH_PASSWORD=
DC01_WINRM_USER=CORP\svc-logreader
DC01_WINRM_PASSWORD=
